{
  "compilerOptions": {
    "skipLibCheck": true,
    "incremental": true,
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "types": ["node"],
    "paths": {
      "@amitkk/*": ["./amitkk/*"],
      "lib/*": ["./lib/*"],
      "pages/*": ["./pages/*"],
      "hooks/*": ["./hooks/*"],
      "contexts/*": ["./contexts/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", "**/*.d.ts", "amitkk/generateComponentMap.js", "amitkk/basic/admin/ProductSlider.jsx", "amitkk/basic/admin/CustomSlider.tsx", "lib/server/test-db.ts"],
  "exclude": ["node_modules"]
}